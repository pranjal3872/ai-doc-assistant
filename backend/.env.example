# Backend Environment Variables
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
PORT=5000
FRONTEND_URL=http://localhost:3000
RAG_SERVICE_URL=http://localhost:8000
SESSION_SECRET=change-this-to-a-secure-random-secret
JWT_SECRET=change-this-to-a-secure-random-secret
NODE_ENV=development

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Brevo API Configuration (Recommended for Render - Uses HTTPS port 443, bypassing blocked SMTP ports)
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
SENDER_EMAIL=your-verified-brevo-sender@example.com

# SMTP / Email Configuration (Optional Fallback)
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

