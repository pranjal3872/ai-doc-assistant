# RAG Service Environment Variables
GROQ_API_KEY="your_groq_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"

# Shared secret between backend and RAG service (same value in both)
RAG_INTERNAL_KEY="change-this-to-a-secure-random-secret"

# Hosted Qdrant (e.g. Qdrant Cloud) so uploaded documents survive redeploys.
# Leave QDRANT_URL empty to store vectors locally in ./qdrant_db (development only).
QDRANT_URL=""
QDRANT_API_KEY=""
