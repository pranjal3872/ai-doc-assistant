# Docker Compose Unified Environment Variables
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
GROQ_API_KEY="your_groq_api_key_here"
TAVILY_API_KEY="your_tavily_api_key_here"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"
SESSION_SECRET="change-this-to-a-secure-random-secret"
JWT_SECRET="change-this-to-a-secure-random-secret"

# Shared secret between backend and RAG service (same value in both)
RAG_INTERNAL_KEY="change-this-to-a-secure-random-secret"

# Hosted Qdrant (e.g. Qdrant Cloud) so uploaded documents survive redeploys.
# Leave QDRANT_URL empty to store vectors locally in ./qdrant_db (development only).
QDRANT_URL=""
QDRANT_API_KEY=""
